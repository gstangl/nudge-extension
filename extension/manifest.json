{
  "manifest_version": 3,
  "name": "Roots Nudge",
  "version": "0.16.14",
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/din-var.woff2"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "description": "UI prompting for your code agent: pick an element or circle a region and prompt straight from the browser - selector, styles and screenshot as context.",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Roots Nudge - toggle (Alt+C)",
    "default_icon": {
      "16": "icons/circle-grey-16.png",
      "32": "icons/circle-grey-32.png",
      "48": "icons/circle-grey-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "vendor/finder.js",
        "styles.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-nudge": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Toggle the Nudge overlay"
    }
  }
}